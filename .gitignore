__pycache__/
*.py[cod]
*$py.class
.venv/
dist/
build/
*.egg-info/
*.egg

# Ignore all files in out/ by default
out/*
# Track git-friendly split files (committed, small diffs)
!out/models.jsonl
!out/pulls.jsonl
!out/metadata.json
!out/seen_slugs.json
!out/discovered_slugs.json
# ollama_catalog.json is a derived artifact — regenerate via: python3 scripts/render_catalog.py

# Test artifacts
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml
*.log

# Example fetch HTMLs
*.html
